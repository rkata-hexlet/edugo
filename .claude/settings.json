{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx --no-install tsc:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [{"matcher": "Bash|Edit|Write|MultiEdit",
      "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""}]}],
    "PostToolUse": [{"matcher": "Edit|Write|MultiEdit",
      "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.py\""}]}]
  }
}
